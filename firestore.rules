rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && currentUser().role == 'admin'
        && currentUser().isBanned != true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCreatingOwnProfile(userId) {
      return isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.isBanned == false
        && request.resource.data.firebaseUID == request.auth.uid;
    }

    function isSafeOwnProfileUpdate(userId) {
      return isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          '_id',
          'id',
          'firebaseId',
          'firebaseUID',
          'email',
          'role',
          'status',
          'isBanned',
          'createdAt'
        ]);
    }

    function bookingAfter(bookingId) {
      return getAfter(
        /databases/$(database)/documents/bookings/$(bookingId)
      ).data;
    }

    function selectedBooking(bookingId) {
      return get(
        /databases/$(database)/documents/bookings/$(bookingId)
      ).data;
    }

    function selectedCourt(fieldId) {
      return get(
        /databases/$(database)/documents/sportFields/$(fieldId)
      ).data;
    }

    function eventRegistrationAfter(eventId, userId) {
      return getAfter(
        /databases/$(database)/documents/event_registrations/$(eventId + '_' + userId)
      ).data;
    }

    function matchmakingMemberAfter(roomId, userId) {
      return getAfter(
        /databases/$(database)/documents/matchmaking_members/$(roomId + '_' + userId)
      ).data;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isCreatingOwnProfile(userId) || isAdmin();
      allow update: if isSafeOwnProfileUpdate(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /fieldComplexes/{venueId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /sportFields/{fieldId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data._id == bookingId
        && request.resource.data.id == bookingId
        && request.resource.data.status == 'booked'
        && request.resource.data.startMinutes is int
        && request.resource.data.endMinutes is int
        && request.resource.data.startMinutes < request.resource.data.endMinutes
        && request.resource.data.startMinutes % 30 == 0
        && request.resource.data.endMinutes % 30 == 0
        && request.resource.data.endMinutes - request.resource.data.startMinutes <= 240
        && request.resource.data.scheduledStart is timestamp
        && request.resource.data.scheduledEnd is timestamp
        && request.resource.data.scheduledStart >= request.time
        && request.resource.data.scheduledEnd > request.resource.data.scheduledStart
        && request.resource.data.participants is int
        && request.resource.data.participants > 0
        && request.resource.data.participants
          <= selectedCourt(request.resource.data.fieldId).capacity
        && selectedCourt(request.resource.data.fieldId).complexId
          == request.resource.data.venueId
        && (
          selectedCourt(request.resource.data.fieldId).status == 'active'
          || selectedCourt(request.resource.data.fieldId).active == true
        )
        && request.resource.data.totalPrice is int
        && request.resource.data.totalPrice >= 0;
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && (
            (request.resource.data.status == 'cancelled'
              && resource.data.paymentStatus != 'pending'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'updatedAt'
              ]))
          )
        );
      allow delete: if isAdmin();
    }

    match /bookingSlotLocks/{lockId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'booked'
        && request.resource.data.startMinutes is int
        && request.resource.data.startMinutes
          >= bookingAfter(request.resource.data.bookingId).startMinutes
        && request.resource.data.startMinutes
          < bookingAfter(request.resource.data.bookingId).endMinutes
        && bookingAfter(request.resource.data.bookingId).userId
          == request.auth.uid
        && bookingAfter(request.resource.data.bookingId).venueId
          == request.resource.data.venueId
        && bookingAfter(request.resource.data.bookingId).fieldId
          == request.resource.data.fieldId
        && bookingAfter(request.resource.data.bookingId).dateKey
          == request.resource.data.dateKey);
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || get(
              /databases/$(database)/documents/bookings/$(resource.data.bookingId)
            ).data.userId == request.auth.uid
          )
        );
    }

    match /favorites/{favoriteId} {
      // A transaction must be allowed to read the deterministic document ID
      // before it creates a new favorite. `resource.data` is unavailable for
      // a document that does not exist yet, so `allow read` cannot be shared
      // with the list rule below.
      allow get: if signedIn()
        && favoriteId.matches('^' + request.auth.uid + '_[^/]+$');
      allow list: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.venueId is string
        && favoriteId == request.auth.uid + '_' + request.resource.data.venueId;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && favoriteId == request.auth.uid + '_' + resource.data.venueId;
      allow update: if false;
    }

    match /coupons/{couponId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.maxPlayers is int
          && request.resource.data.minPlayers is int
          && request.resource.data.minPlayers > 0
          && request.resource.data.maxPlayers >= request.resource.data.minPlayers
          && request.resource.data.availableSlots is int
          && request.resource.data.availableSlots >= 0
          && request.resource.data.availableSlots < request.resource.data.maxPlayers
        );
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'registeredCount',
            'updatedAt'
          ])
          && request.resource.data.registeredCount
            == resource.data.registeredCount + 1
          && request.resource.data.registeredCount <= resource.data.capacity
          && eventRegistrationAfter(eventId, request.auth.uid).eventId == eventId
          && eventRegistrationAfter(eventId, request.auth.uid).userId
            == request.auth.uid
          || (
            resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && (
              request.resource.data.status == resource.data.status
              || request.resource.data.status == 'cancelled'
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'title', 'description', 'deadline', 'playerLevel',
              'playStyle', 'teamPreference', 'minPlayers', 'maxPlayers',
              'status', 'updatedAt'
            ])
          )
        );
    }

    match /event_registrations/{registrationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId is string
        && registrationId
          == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.status == 'registered';
      allow update, delete: if isAdmin();
    }

    match /matchmaking_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.maxMembers >= 2
        && request.resource.data.status == 'open'
        && request.resource.data.bookingId is string
        && request.resource.data.venueId is string
        && request.resource.data.fieldId is string
        && request.resource.data.venueName is string
        && request.resource.data.courtName is string
        && request.resource.data.playAt is timestamp
        && selectedBooking(request.resource.data.bookingId).userId
          == request.auth.uid
        && selectedBooking(request.resource.data.bookingId).status
          == 'booked'
        && selectedBooking(request.resource.data.bookingId).venueId
          == request.resource.data.venueId
        && selectedBooking(request.resource.data.bookingId).fieldId
          == request.resource.data.fieldId
        && selectedBooking(request.resource.data.bookingId).venueName
          == request.resource.data.venueName
        && selectedBooking(request.resource.data.bookingId).courtName
          == request.resource.data.courtName
        && selectedBooking(request.resource.data.bookingId).scheduledStart
          == request.resource.data.playAt
        && selectedBooking(request.resource.data.bookingId).scheduledStart
          > request.time;
      allow update: if isAdmin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberCount',
            'updatedAt'
          ])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.memberCount <= resource.data.maxMembers
          && matchmakingMemberAfter(roomId, request.auth.uid).roomId == roomId
          && matchmakingMemberAfter(roomId, request.auth.uid).userId
            == request.auth.uid
        );
      allow delete: if isAdmin() || (
        signedIn() && resource.data.createdBy == request.auth.uid
      );
    }

    match /matchmaking_members/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.roomId is string
        && memberId == request.resource.data.roomId + '_' + request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /equipments/{itemId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /consumables/{itemId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /policy_categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /policies/{policyId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
