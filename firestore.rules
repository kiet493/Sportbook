rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && currentUser().role == 'admin'
        && currentUser().isBanned != true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isOwnProfileDocument() {
      return signedIn()
        && (
          resource.data.firebaseUID == request.auth.uid
          || resource.data.email == request.auth.token.email
        );
    }

    function isCreatingOwnProfile(userId) {
      return signedIn()
        && (
          userId == request.auth.uid
          || request.resource.data.firebaseUID == request.auth.uid
          || request.resource.data.email == request.auth.token.email
        );
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isOwnProfileDocument() || isAdmin();
      allow list: if isOwnProfileDocument() || isAdmin();
      allow create: if isCreatingOwnProfile(userId) || isAdmin();
      allow update: if isOwner(userId) || isOwnProfileDocument() || isAdmin();
      allow delete: if isAdmin();
    }

    match /fieldComplexes/{venueId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /sportFields/{fieldId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /bookingSlotLocks/{lockId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
  }
}
