rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && currentUser().role == 'admin'
        && currentUser().isBanned != true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCreatingOwnProfile(userId) {
      return isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.isBanned == false
        && request.resource.data.firebaseUID == request.auth.uid;
    }

    function isSafeOwnProfileUpdate(userId) {
      return isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          '_id',
          'id',
          'firebaseId',
          'firebaseUID',
          'email',
          'role',
          'staffVenueId',
          'staffVenueName',
          'status',
          'isBanned',
          'createdAt'
        ]);
    }

    function bookingAfter(bookingId) {
      return getAfter(
        /databases/$(database)/documents/bookings/$(bookingId)
      ).data;
    }

    function selectedBooking(bookingId) {
      return get(
        /databases/$(database)/documents/bookings/$(bookingId)
      ).data;
    }

    function selectedCourt(fieldId) {
      return get(
        /databases/$(database)/documents/sportFields/$(fieldId)
      ).data;
    }

    function eventRegistrationAfter(eventId, userId) {
      return getAfter(
        /databases/$(database)/documents/event_registrations/$(eventId + '_' + userId)
      ).data;
    }

    function isStaffForVenue(venueId) {
      return signedIn()
        && currentUser().role == 'staff'
        && currentUser().isBanned != true
        && currentUser().staffVenueId == venueId;
    }

    function eventAfter(eventId) {
      return getAfter(
        /databases/$(database)/documents/events/$(eventId)
      ).data;
    }

    function matchmakingMemberAfter(roomId, userId) {
      return getAfter(
        /databases/$(database)/documents/matchmaking_members/$(roomId + '_' + userId)
      ).data;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isCreatingOwnProfile(userId) || isAdmin();
      allow update: if isSafeOwnProfileUpdate(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /fieldComplexes/{venueId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /sportFields/{fieldId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || isStaffForVenue(resource.data.venueId);
      allow create: if isAdmin()
        || (signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data._id == bookingId
        && request.resource.data.id == bookingId
        && request.resource.data.status == 'booked'
        && request.resource.data.startMinutes is int
        && request.resource.data.endMinutes is int
        && request.resource.data.startMinutes < request.resource.data.endMinutes
        && request.resource.data.startMinutes % 30 == 0
        && request.resource.data.endMinutes % 30 == 0
        && request.resource.data.endMinutes - request.resource.data.startMinutes <= 240
        && request.resource.data.scheduledStart is timestamp
        && request.resource.data.scheduledEnd is timestamp
        && request.resource.data.scheduledStart >= request.time
        && request.resource.data.scheduledEnd > request.resource.data.scheduledStart
        && request.resource.data.participants is int
        && request.resource.data.participants > 0
        && request.resource.data.participants
          <= selectedCourt(request.resource.data.fieldId).capacity
        && selectedCourt(request.resource.data.fieldId).complexId
          == request.resource.data.venueId
        && (
          selectedCourt(request.resource.data.fieldId).status == 'active'
          || selectedCourt(request.resource.data.fieldId).active == true
        )
        && request.resource.data.totalPrice is int
        && request.resource.data.totalPrice >= 0
        );
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && (
            (request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'updatedAt'
              ]))
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentStatus', 'paymentMethod', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /bookingSlotLocks/{lockId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'booked'
        && request.resource.data.startMinutes is int
        && request.resource.data.startMinutes
          >= bookingAfter(request.resource.data.bookingId).startMinutes
        && request.resource.data.startMinutes
          < bookingAfter(request.resource.data.bookingId).endMinutes
        && bookingAfter(request.resource.data.bookingId).userId
          == request.auth.uid
        && bookingAfter(request.resource.data.bookingId).venueId
          == request.resource.data.venueId
        && bookingAfter(request.resource.data.bookingId).fieldId
          == request.resource.data.fieldId
        && bookingAfter(request.resource.data.bookingId).dateKey
          == request.resource.data.dateKey)
        || (signedIn()
          && request.resource.data.status == 'event'
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.eventId is string
          && eventAfter(request.resource.data.eventId).createdBy == request.auth.uid
          && eventAfter(request.resource.data.eventId).venueId
            == request.resource.data.venueId
          && eventAfter(request.resource.data.eventId).fieldId
            == request.resource.data.fieldId
          && (
            eventAfter(request.resource.data.eventId).status == 'pending_payment'
            || eventAfter(request.resource.data.eventId).status == 'open'
          ));
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.bookingId == request.resource.data.bookingId
          && request.resource.data.status == 'event'
          && request.resource.data.eventId is string
          && eventAfter(request.resource.data.eventId).createdBy == request.auth.uid);
      allow delete: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || get(
              /databases/$(database)/documents/bookings/$(resource.data.bookingId)
            ).data.userId == request.auth.uid
          )
        );
    }

    match /favorites/{favoriteId} {
      // A transaction must be allowed to read the deterministic document ID
      // before it creates a new favorite. `resource.data` is unavailable for
      // a document that does not exist yet, so `allow read` cannot be shared
      // with the list rule below.
      allow get: if signedIn()
        && favoriteId.matches('^' + request.auth.uid + '_[^/]+$');
      allow list: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.venueId is string
        && favoriteId == request.auth.uid + '_' + request.resource.data.venueId;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && favoriteId == request.auth.uid + '_' + resource.data.venueId;
      allow update: if false;
    }

    match /staffSales/{saleId} {
      allow read: if isAdmin() || isStaffForVenue(resource.data.venueId);
      allow create, update: if isAdmin()
        || (
          signedIn()
          && request.resource.data.staffId == request.auth.uid
          && isStaffForVenue(request.resource.data.venueId)
          && saleId == request.resource.data.bookingId
          && selectedBooking(request.resource.data.bookingId).venueId
            == request.resource.data.venueId
          && selectedBooking(request.resource.data.bookingId).dateKey
            == request.resource.data.dateKey
          && request.resource.data.waterQuantity is int
          && request.resource.data.waterQuantity >= 0
          && request.resource.data.racketQuantity is int
          && request.resource.data.racketQuantity >= 0
          && request.resource.data.waterUnitPrice == 30000
          && request.resource.data.racketUnitPrice == 100000
          && request.resource.data.totalRevenue
            == request.resource.data.waterQuantity * 30000
              + request.resource.data.racketQuantity * 100000
        );
      allow delete: if isAdmin();
    }

    match /staffReports/{reportId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.staffId == request.auth.uid);
      allow create: if signedIn()
        && currentUser().role == 'staff'
        && currentUser().isBanned != true
        && request.resource.data.staffId == request.auth.uid
        && request.resource.data.venueId == currentUser().staffVenueId
        && request.resource.data.resolved == false
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'resolved', 'resolvedAt', 'updatedAt'
        ])
        && request.resource.data.resolved is bool;
      allow delete: if isAdmin();
    }

    match /venueReviews/{reviewId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.venueId is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && reviewId == request.resource.data.venueId + '_' + request.auth.uid;
      allow delete: if false;
    }

    match /coupons/{couponId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.keys().hasOnly([
            'userId',
            'title',
            'body',
            'type',
            'read',
            'createdAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.body is string
          && request.resource.data.type is string
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time
        );
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read'
          ])
          && request.resource.data.read == true
        );
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'pending_payment'
          && request.resource.data.isActive == false
          && request.resource.data.paymentStatus == 'unpaid'
          && request.resource.data.maxPlayers is int
          && request.resource.data.minPlayers is int
          && request.resource.data.minPlayers > 0
          && request.resource.data.maxPlayers >= request.resource.data.minPlayers
          && request.resource.data.availableSlots is int
          && request.resource.data.availableSlots >= 0
          && request.resource.data.availableSlots <= request.resource.data.maxPlayers
          && request.resource.data.estimatedPrice is int
          && request.resource.data.estimatedPrice > 0
          && request.resource.data.totalDurationMinutes is int
          && request.resource.data.totalDurationMinutes > 0
          && request.resource.data.hourlyRate == 50000
          && request.resource.data.estimatedPrice * 60
            == request.resource.data.totalDurationMinutes
              * request.resource.data.hourlyRate
          && request.resource.data.startAt is timestamp
          && request.resource.data.startAt >= request.time + duration.value(2, 'd')
        );
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (
          // Người dùng đăng ký: chỉ tăng registeredCount + 1, sau khi event_registration được tạo.
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'registeredCount',
            'updatedAt'
          ])
          && request.resource.data.registeredCount
            == resource.data.registeredCount + 1
          && request.resource.data.registeredCount <= resource.data.capacity
          && eventRegistrationAfter(eventId, request.auth.uid).eventId == eventId
          && eventRegistrationAfter(eventId, request.auth.uid).userId
            == request.auth.uid
        )
        || (
          // Chủ sự kiện cập nhật thông tin hoặc huỷ sự kiện.
          signedIn()
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && (
            request.resource.data.status == resource.data.status
            || request.resource.data.status == 'cancelled'
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'title', 'description', 'deadline', 'playerLevel',
            'playStyle', 'teamPreference', 'minPlayers', 'maxPlayers',
            'status', 'updatedAt'
          ])
        )
        || (
          // Chủ sự kiện xác nhận thanh toán: chuyển từ pending_payment → open.
          signedIn()
          && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'pending_payment'
          && resource.data.paymentStatus == 'unpaid'
          && request.resource.data.status == 'open'
          && request.resource.data.paymentStatus == 'paid'
          && request.resource.data.paymentMethod == 'wallet'
          && request.resource.data.isActive == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'paymentStatus', 'paymentMethod', 'status', 'isActive',
            'paidAt', 'updatedAt'
          ])
        );
    }

    match /event_registrations/{registrationId} {
      // allow get: cần cho phép đọc kể cả khi document chưa tồn tại
      // (transaction dùng get() để kiểm tra đăng ký trùng).
      // Dùng pattern trên registrationId thay vì resource.data (null khi chưa tồn tại).
      allow get: if isAdmin()
        || (
          signedIn()
          && (
            registrationId.matches('^[^_]+_' + request.auth.uid + '$')
            || (resource != null && resource.data.userId == request.auth.uid)
          )
        );
      // allow list: người dùng xem đăng ký của mình; chủ sự kiện xem danh sách.
      allow list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (
          signedIn()
          && resource.data.eventId is string
          && get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.createdBy
            == request.auth.uid
        );
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId is string
        && registrationId
          == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.status == 'registered';
      allow update, delete: if isAdmin();
    }

    match /matchmaking_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.maxMembers >= 2
        && request.resource.data.status == 'open'
        && request.resource.data.bookingId is string
        && request.resource.data.venueId is string
        && request.resource.data.fieldId is string
        && request.resource.data.venueName is string
        && request.resource.data.courtName is string
        && request.resource.data.playAt is timestamp
        && selectedBooking(request.resource.data.bookingId).userId
          == request.auth.uid
        && selectedBooking(request.resource.data.bookingId).status
          == 'booked'
        && selectedBooking(request.resource.data.bookingId).venueId
          == request.resource.data.venueId
        && selectedBooking(request.resource.data.bookingId).fieldId
          == request.resource.data.fieldId
        && selectedBooking(request.resource.data.bookingId).venueName
          == request.resource.data.venueName
        && selectedBooking(request.resource.data.bookingId).courtName
          == request.resource.data.courtName
        && selectedBooking(request.resource.data.bookingId).scheduledStart
          == request.resource.data.playAt
        && selectedBooking(request.resource.data.bookingId).scheduledStart
          > request.time;
      allow update: if isAdmin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberCount',
            'updatedAt'
          ])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.memberCount <= resource.data.maxMembers
          && matchmakingMemberAfter(roomId, request.auth.uid).roomId == roomId
          && matchmakingMemberAfter(roomId, request.auth.uid).userId
            == request.auth.uid
        );
      allow delete: if isAdmin() || (
        signedIn() && resource.data.createdBy == request.auth.uid
      );
    }

    match /matchmaking_members/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.roomId is string
        && memberId == request.resource.data.roomId + '_' + request.auth.uid
        && (
          request.resource.data.status == 'pending'
          || (
            request.resource.data.status == 'approved'
            && getAfter(
              /databases/$(database)/documents/matchmaking_rooms/$(request.resource.data.roomId)
            ).data.createdBy == request.auth.uid
          )
        );
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberCount', 'updatedAt'
          ])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.memberCount <= resource.data.maxMembers
        )
        || (
          signedIn()
          && get(
            /databases/$(database)/documents/matchmaking_rooms/$(resource.data.roomId)
          ).data.createdBy == request.auth.uid
          && resource.data.status == 'pending'
          && (request.resource.data.status == 'approved'
            || request.resource.data.status == 'rejected')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewedAt'
          ])
        );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /equipments/{itemId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /consumables/{itemId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /policy_categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /policies/{policyId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
